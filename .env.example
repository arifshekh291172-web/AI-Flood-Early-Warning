# ===================================================================
# NE-SHIELD: Real-Time Landslide Early Warning & Disaster Platform
# Environment Configuration
# ===================================================================

# Application Environment: 'development' or 'production'
APP_ENV=development
APP_NAME=NE-SHIELD
DEBUG=true

# Operational Mode: 'LIVE' (Real APIs and strict provenance) or 'DEMO' (Allows seeded test events)
OPERATIONAL_MODE=LIVE

# Database Configuration (PostgreSQL 16 + PostGIS 3.4)
# In development without local postgres, falls back to sqlite:///./ne_shield.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ne_shield
# Docker Compose URL:
# DATABASE_URL=postgresql://ne_shield_admin:secure_shield_pass@postgres:5432/ne_shield

# Redis Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# Security & JWT Authentication
JWT_SECRET=ne_shield_super_secure_jwt_secret_key_change_in_production_987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# India Meteorological Department (IMD) Official API Platform
# Portal: https://api.imd.gov.in/public/
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=your_imd_api_key_here
IMD_CLIENT_ID=your_registered_imd_client_id
IMD_TIMEOUT_SECONDS=10
IMD_CACHE_TTL_SECONDS=900

# ISRO / NRSC Bhuvan Disaster Services
# Geoportal: https://bhuvan-app1.nrsc.gov.in/disaster/disaster.php
BHUVAN_WMS_URL=https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms
BHUVAN_API_KEY=your_bhuvan_token_if_required

# NDMA / SACHET Machine-Readable Feed
# Portal: https://sachet.ndma.gov.in/
NDMA_CAP_FEED_URL=https://sachet.ndma.gov.in/cap_feed/rss
NDMA_API_KEY=your_ndma_api_key

# Scheduling Intervals (in minutes)
IMD_WEATHER_INTERVAL=15
RAINFALL_INTERVAL=15
WARNING_INTERVAL=30
SENSOR_INTERVAL=5
GOV_ALERT_INTERVAL=15
RISK_PREDICTION_INTERVAL=10
DATA_SOURCE_HEALTH_INTERVAL=2

# ML Model Configuration
MODEL_PATH=backend/app/ml/models/active_model.json
HISTORICAL_DATASET_PATH=backend/app/ml/data/ne_landslides_historical.csv
MIN_CONFIDENCE_THRESHOLD=0.65

# Map Services
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Notification & Alert Integrations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@ne-shield.gov.in
SMTP_PASSWORD=
SMS_PROVIDER=
SMS_API_KEY=
